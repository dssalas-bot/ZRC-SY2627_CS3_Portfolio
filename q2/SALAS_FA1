class libmaterial:
    def __init__(self, title, author):
        self.title = title
        self.author = author

    def display_info(self):
        print(f"Title: {self.title}, Author: {self.author}")

class magazine(libmaterial):
    def __init__(self, title, author, issue):
        super().__init__(title, author)
        self.issue = issue

    def display_info(self):
        print(f"Title: {self.title}, Author: {self.author}, Issue: {self.issue}")

class book(libmaterial):
    def __init__(self, title, author, no_of_pages):
        super().__init__(title, author)
        self.no_of_pages = no_of_pages

    def display_info(self):
        print(f"Title: {self.title}, Author: {self.author}, No. of Pages: {self.no_of_pages}")

libmat1 = libmaterial("The Great Gatsby", "F. Scott Fitzgerald")
magazine1 = magazine("National Geographic", "Various Authors", "March 2023")    
book1 = book("To Kill a Mockingbird", "Harper Lee", 281)

print("Library Materials:")
libmat1.display_info()
magazine1.display_info()
book1.display_info()
