class animal:
    def __init__(self, name):
        self.__name = name

    def eat(self):
        print(f"{self.__name} is eating.")

    def make_sound(self):
        print(f"{self.__name} is making a sound.")

class lion(animal):
    def __init__(self, name):
        super().__init__(name)

    def eat(self):
        print(f"{self.__name} eats fresh meat")

    def make_sound(self):
        print(f"{self.__name} roars")

class elephant(animal):
    def __init__(self, name):
        super().__init__(name)

    def eat(self):
        print(f"{self.__name} eats grass and fruits")

    def make_sound(self):
        print(f"{self.__name} trumpets")

class monkey(animal):
    def __init__(self, name):
        super(). __init__(name)

    def eat(self):
        print(f"{self.__name} eats banananas")

    def make_sound(self):
        print(f"{self.__name} chatters")

animal1 = animal("Generic Animal")
lion1 = lion("Simba")
elephant1 = elephant("Dumbo")
monkey1 = monkey("George")

print("Welcome to the Animal Kingdom!")

animal1.eat()
animal1.make_sound()

lion1.eat()
lion1.make_sound()

elephant1.eat()
elephant1.make_sound()

monkey1.eat()
